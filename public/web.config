<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS static MIME mappings for the built console.

  Vite copies everything in client/public/ to the root of dist/, so this file
  ships next to index.html and applies to the deployed folder automatically.

  Why it is needed: for an extension it has no explicit mapping for, IIS falls
  back to the Windows registry, and on this machine HKLM\SOFTWARE\Classes\.js
  has an EMPTY "Content Type" value. IIS then serves the bundle as
  application/octet-stream, and because the entry point is
  <script type="module">, strict MIME checking refuses to execute it — the
  browser reports "Expected a JavaScript-or-Wasm module script" and #root is
  never mounted, so the page renders blank.

  <remove> precedes each <mimeMap> because a mapping inherited from a parent
  applicationHost.config would otherwise make the add a duplicate-key error
  (HTTP 500.19) rather than an override.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
